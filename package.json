{
  "name": "html-string-splitter",
  "version": "3.0.0",
  "description": "Split, truncate, chunk and stream HTML by character, word, sentence, line, byte, token or tag while preserving valid HTML structure.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HrDelwar/html-string-splitter.git"
  },
  "keywords": [
    "html",
    "html-split",
    "html-truncate",
    "html-chunk",
    "html-excerpt",
    "html-snippet",
    "html-stream",
    "html-tokenizer",
    "truncate",
    "split",
    "chunk",
    "rag",
    "llm",
    "tokens",
    "streaming",
    "word-count",
    "reading-time",
    "text-extraction",
    "typescript"
  ],
  "author": "HrDelwar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HrDelwar/html-string-splitter/issues"
  },
  "homepage": "https://github.com/HrDelwar/html-string-splitter#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
